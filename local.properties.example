## This file is local-only. Copy to local.properties and fill in.
sdk.dir=C:/Users/YOUR_USER/AppData/Local/Android/Sdk
# Optional cloud detection (MiniMax). Leave empty to use on-device only.
# Never commit a real key.
minimax.api.key=
# Optional. Empty uses https://api.minimax.cn/v1/chat/completions
# minimax.endpoint=
