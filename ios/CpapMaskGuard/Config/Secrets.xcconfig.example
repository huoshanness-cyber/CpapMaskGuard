// Copy this file to Secrets.xcconfig in the same folder.
// Secrets.xcconfig is gitignored. Never commit a real MiniMax key.
// Debug.xcconfig / Release.xcconfig include it. Info.plist maps MINIMAX_API_KEY.
// The app uses https://cpap.njxxzf.cn by default and does not need this key.
// Set CPAP_RELAY_BASE = off only if you want the direct MiniMax path below.
//
// 把本文件复制为同目录 Secrets.xcconfig（已被 git 忽略）。
// 默认走官方中转，不要把真 Key 提交进仓库。

MINIMAX_API_KEY =

// Optional. Leave unset to keep https://api.minimax.cn/v1/chat/completions
// MINIMAX_ENDPOINT = https://api.minimax.cn/v1/chat/completions
